{
  "extends": "airbnb-base",
  "rules": {
    "no-underscore-dangle": 0,
    "no-console": 0,
    "linebreak-style": 0,
    "no-unused-vars": ["error", { "argsIgnorePattern": "next" }]
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" }
}